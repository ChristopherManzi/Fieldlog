<Window x:Class="Fieldlog.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Fieldlog.App.ViewModels"
        Title="Fieldlog"
        Width="560" Height="520"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <DockPanel Margin="12">

        <!-- Connection bar -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="EndpointBox"
                     Grid.Column="0"
                     Margin="0,0,8,0"
                     VerticalContentAlignment="Center"
                     Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsOpen, Converter={StaticResource Invert}}" />

            <Button Grid.Column="1"
                    x:Name="OpenButton"
                    Command="{Binding OpenCommand}" />
            <Button Grid.Column="2"
                    x:Name="CloseButton"
                    Margin="0"
                    Command="{Binding CloseCommand}" />
        </Grid>

        <!-- Action bar -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="RecordButton" Command="{Binding RecordCommand}" />
            <Button x:Name="PauseButton" Command="{Binding PauseCommand}" />
            <TextBlock x:Name="StatusBlock"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Foreground="{StaticResource AccentBrush}"
                       Text="{Binding StatusText}" />
        </StackPanel>

        <!-- Channel table -->
        <DataGrid ItemsSource="{Binding Channels}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{StaticResource PanelBrush}"
                  RowHeight="30"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn x:Name="ColumnSelected"
                                        Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                        Width="Auto" />
                <DataGridTextColumn x:Name="ColumnChannel"
                                    Binding="{Binding DisplayName}"
                                    IsReadOnly="True"
                                    Width="*" />
                <DataGridTextColumn x:Name="ColumnInterval"
                                    Binding="{Binding IntervalSeconds, UpdateSourceTrigger=LostFocus}"
                                    Width="110" />
                <DataGridTextColumn x:Name="ColumnLastValue"
                                    Binding="{Binding LastValue}"
                                    IsReadOnly="True"
                                    Width="120" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="IsEnabled" Value="{Binding Editable}" />
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

    </DockPanel>
</Window>
