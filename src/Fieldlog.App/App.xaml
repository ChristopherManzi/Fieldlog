<Application x:Class="Fieldlog.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Fieldlog.App.Infrastructure">
    <Application.Resources>
        <infra:BooleanNotConverter x:Key="Invert" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2E6B4F" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F4F6F5" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="92" />
        </Style>
    </Application.Resources>
</Application>
