<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Fieldlog.App</RootNamespace>
    <AssemblyName>Fieldlog</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fieldlog.Core\Fieldlog.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\config\channels.json" Link="config\channels.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
